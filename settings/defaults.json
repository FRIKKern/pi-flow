{
  "defaultProvider": "cursor",
  "defaultModel": "composer-2.5",
  "defaultThinkingLevel": "medium",
  "enabledModels": ["composer-2.5", "composer-2.5-fast"],
  "packages": ["pi-flow"],
  "piFlow": {
    "policy": {
      "blockDestructiveShell": true,
      "blockDestructiveGit": true,
      "redactSecrets": true,
      "preferTrashOverRm": true
    },
    "modelRoles": {
      "goal": { "model": "composer-2.5", "thinking": "high" },
      "plan": { "model": "composer-2.5", "thinking": "high" },
      "build": { "model": "composer-2.5", "thinking": "medium" },
      "review": { "model": "composer-2.5", "thinking": "high" }
    }
  },
  "subagents": {
    "orchestratorFirst": true,
    "agentOverrides": {
      "scout": { "model": "composer-2.5" },
      "researcher": {
        "model": "composer-2.5",
        "tools": "read, bash, mcp:browserbase",
        "skills": "browserbase",
        "inheritSkills": false
      },
      "planner": { "model": "composer-2.5", "thinking": "high" },
      "worker": { "model": "composer-2.5" },
      "reviewer": { "model": "composer-2.5", "thinking": "high" },
      "oracle": { "model": "composer-2.5", "thinking": "high" }
    },
    "isolation": {
      "mode": "worktree",
      "merge": "patch"
    }
  }
}
