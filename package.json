{
  "name": "pi-flow",
  "version": "0.5.0",
  "description": "Paperflow lifecycle in Pi (CMUX): goal → plan → grill → build → review. HTML artifacts, Beads, MCP subagents. Model-agnostic; Composer 2.5 default.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "paperflow",
    "pi-flow",
    "cmux",
    "beads",
    "mcp",
    "subagents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FRIKKern/pi-flow.git"
  },
  "files": [
    "agents/",
    "bin/",
    "scripts/",
    "extensions/",
    "prompts/",
    "settings/",
    "skills/",
    "skills-cmux/",
    "docs/",
    "lib/",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "FORKS.md"
  ],
  "bin": {
    "pi-flow": "./bin/pi-flow"
  },
  "scripts": {
    "postinstall": "node scripts/verify-bundled-deps.mjs"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/FRIKKern/pi-flow/main/assets/logo.svg",
    "extensions": [
      "./extensions/pi-flow-setup/index.ts",
      "./extensions/pi-flow-host/index.ts",
      "node_modules/pi-cursor-provider/index.ts",
      "node_modules/pi-mcp-adapter/index.ts",
      "node_modules/pi-subagents/src/extension/index.ts"
    ],
    "skills": [
      "./skills",
      "node_modules/pi-subagents/skills"
    ],
    "prompts": [
      "./prompts",
      "node_modules/pi-subagents/prompts"
    ]
  },
  "dependencies": {
    "pi-cursor-provider": "^0.1.11",
    "pi-mcp-adapter": "^2.6.1",
    "pi-subagents": "^0.24.3",
    "typebox": "^1.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.52.10"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
